  {
   "i": 0,
   "t": 12.600000000000001,
   "who": "host",
   "cast": "host",
   "text": "各位觀眾朋友大家好！歡迎收看一字千金，A B C 海外特別節目，我是主持人增國城！",
   "feel": "excited"
  },
  {
   "i": 1,
   "t": 21.100000000000005,
   "who": "host",
   "cast": "host",
