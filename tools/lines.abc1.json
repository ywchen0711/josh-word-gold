   "t": 36.300000000000004,
   "who": "jasper",
   "cast": "jasper",
   "text": "哥哥加油！Add oil！",
   "feel": "excited"
  },
  {
   "i": 4,
   "t": 40.6,
   "who": "host",
   "cast": "host",
   "text": "Add oil……好，這位弟弟的翻譯，很有創意。",
